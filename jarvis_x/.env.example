# Copy to .env (same folder as run.py) and edit. Never put an Anthropic API key here:
# JARVIS runs on your Claude Code login, and removes ANTHROPIC_API_KEY at startup.

CITY=Shillong

# WhatsApp: auto = send through WhatsApp Web after approval, web = open WhatsApp Web with the text typed,
# app = open the WhatsApp desktop app with the text typed
WHATSAPP_MODE=auto

# Voices (audition with: python scripts\voice_test.py robin)
# JARVIS_VOICE=en-GB-RyanNeural
# JARVIS_RATE=+4%
# JARVIS_PITCH=-2Hz
# FRIDAY_VOICE=en-IE-EmilyNeural
# FRIDAY_RATE=+8%
# ROBIN_VOICE=en-US-AvaMultilingualNeural
# ROBIN_RATE=-4%
# VOICE_KEEP_COMMAS=1
